# Application Environment Configuration
APP_NAME=LeaveDesk
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/leavedesk
TEST_DATABASE_URL=sqlite:///./test.db

# Authentication & Security
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=leave-desk-super-secret-key-change-in-production-iqg-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration (comma-separated origins, or specific domains)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]
